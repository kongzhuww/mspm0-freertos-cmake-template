{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 调试本地测试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_host/run_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/ming64-new/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "[1] 构建本地测试 (Local Test)"
        }
    ]
}